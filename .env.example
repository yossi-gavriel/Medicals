# ──────────────────────────────────────────────────────────────────────
#  Drug Safety Engine — example environment configuration
#  Copy to `.env` and adjust per environment. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────

# Application
APP_NAME=Drug Safety Engine
APP_ENV=dev
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Auth — comma-separated list of accepted API keys for the public API
API_KEYS=dev-local-key
# Optional: keys allowed only on /internal/* routes
INTERNAL_API_KEYS=

# CORS
CORS_ALLOW_ORIGINS=*

# Database (async URL used by the app, sync URL used by Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/drug_safety
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis (cache + queue)
REDIS_URL=redis://redis:6379/0
QUEUE_REDIS_URL=redis://redis:6379/1

# Object storage for raw documents (s3 | local)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_LOCAL_PATH=./local_storage/documents
DOCUMENT_STORAGE_S3_BUCKET=
DOCUMENT_STORAGE_S3_PREFIX=documents/
DOCUMENT_STORAGE_S3_REGION=eu-central-1

# Drug interaction providers
ENABLED_PROVIDERS=lexicomp,micromedex,drugbank
PROVIDER_PRIORITY=lexicomp,micromedex,drugbank,first_databank,uptodate,dynamed
LEXICOMP_API_URL=
LEXICOMP_API_KEY=
MICROMEDEX_API_URL=
MICROMEDEX_API_KEY=
DRUGBANK_API_URL=
DRUGBANK_API_KEY=
FIRST_DATABANK_API_URL=
FIRST_DATABANK_API_KEY=
UPTODATE_API_URL=
UPTODATE_API_KEY=
DYNAMED_API_URL=
DYNAMED_API_KEY=

# Reference data sources
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST
ISRAEL_BASKET_API_URL=
ISRAEL_BASKET_API_KEY=
ISRAEL_BASKET_DATASET_PATH=data/israel_drug_basket.json

# Medical classifier
MEDICAL_CLASSIFIER_PROCEDURE_DEFINITIONS_PATH=data/procedure_definitions
MEDICAL_CLASSIFIER_MASK_PII_BEFORE_LLM=true
MEDICAL_CLASSIFIER_LLM_PROVIDER=disabled
MEDICAL_CLASSIFIER_LLM_MODEL=gpt-4o-mini
MEDICAL_CLASSIFIER_LLM_API_KEY_ENV_NAME=OPENAI_API_KEY
MEDICAL_CLASSIFIER_LLM_API_KEY=
MEDICAL_CLASSIFIER_LLM_TIMEOUT_SECONDS=15

# Async classification pipeline
CLASSIFICATION_QUEUE_NAME=medical_classification
CLASSIFICATION_MAX_RETRIES=3
CLASSIFICATION_JOB_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=8
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=50

# Bulk classification — max documents per /v1/classifications/batch call
CLASSIFICATION_BATCH_MAX_ITEMS=500

# Rate limiting — fixed-window counter per API key + tenant (Redis-backed,
# in-memory fallback). Disabled by default; flip to true for production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_EXCLUDED_PATHS=/health,/ready,/metrics,/docs,/redoc,/openapi.json

# Webhook signing (HMAC-SHA256) for outbound callbacks
WEBHOOK_SIGNING_SECRET=

# Optional: provider keys read from process env at runtime
OPENAI_API_KEY=
